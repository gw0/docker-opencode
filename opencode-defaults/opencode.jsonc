{
  "$schema": "https://opencode.ai/config.json",
  "keybinds": {
    "session_child_cycle": "ctrl+tab,<leader>d", // was "ctrl+right"
    "session_child_cycle_reverse": "ctrl+shift+tab,<leader>f", // was "ctrl+left"
    "messages_page_up": "ctrl+alt+b,pageup", // was "pageup"
    "messages_page_down": "ctrl+alt+f,pagedown", // was "pagedown"
    "messages_first": "ctrl+g", // was "ctrl+g,home"
    "messages_last": "ctrl+alt+g", // was "ctrl+alt+g,end"
    "history_previous": "ctrl+up", // was "up"
    "history_next": "ctrl+down", // was "down"
  },
  "tui": {
    "scroll_speed": 6,
  },
  "autoupdate": false,
  "share": "disabled",
  "provider": {
    "anthropic": {
      "models": {
        "claude-sonnet-4-5": {
          "options": {
            // "thinking": {
            //   "type": "enabled",
            //   "budgetTokens": 16000,
            // },
          },
        },
      },
    },
  },
  "model": "anthropic/claude-sonnet-4-5",
  "small_model": "anthropic/claude-haiku-4-5",
  "permission": {
    "bash": {
      "*": "ask",
    },
    "edit": "ask",
    "webfetch": "ask",
    "doom_loop": "ask",
    "external_directory": "deny",
  },
  "agent": {
    "build": {
      "disable": true,
      "buildin": false,
    },
    "plan": {
      "disable": true,
      "buildin": false,
    },
  },
}